{
  "outputDirectory": "htdocs",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.nsancar.com" }], "destination": "https://nsancar.com/:path*", "permanent": true },
    { "source": "/index.html",         "destination": "/",             "permanent": true },
    { "source": "/about.html",         "destination": "/hakkimda",     "permanent": true },
    { "source": "/about",              "destination": "/hakkimda",     "permanent": true },
    { "source": "/hakkimda.html",      "destination": "/hakkimda",     "permanent": true },
    { "source": "/project.html",       "destination": "/projeler",     "permanent": true },
    { "source": "/project",            "destination": "/projeler",     "permanent": true },
    { "source": "/projeler.html",      "destination": "/projeler",     "permanent": true },
    { "source": "/services.html",      "destination": "/servisler",    "permanent": true },
    { "source": "/services",           "destination": "/servisler",    "permanent": true },
    { "source": "/servisler.html",     "destination": "/servisler",    "permanent": true },
    { "source": "/fav.html",           "destination": "/aktiviteler",  "permanent": true },
    { "source": "/fav",                "destination": "/aktiviteler",  "permanent": true },
    { "source": "/aktiviteler.html",   "destination": "/aktiviteler",  "permanent": true },
    { "source": "/galeri",             "destination": "/gallery",      "permanent": true },
    { "source": "/galeri/:path*",      "destination": "/gallery/:path*", "permanent": true },
    { "source": "/gallery/index.html", "destination": "/gallery",    "permanent": true },
    { "source": "/blog.html",          "destination": "/blog",         "permanent": true }
  ],
  "rewrites": [
    { "source": "/IKU/:path*", "destination": "/api/gone" }
  ],
  "functions": {
    "htdocs/api/*.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/data/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
