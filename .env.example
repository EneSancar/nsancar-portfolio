# Vercel → Project → Settings → Environment Variables
# Production, Preview ve Development için ekle

# --- Admin panel (Hakkımda / Projeler) ---
ADMIN_SECRET=guclu_rastgele_bir_deger
GITHUB_TOKEN=ghp_xxxxxxxx
GITHUB_OWNER=EneSancar
GITHUB_REPO=nsancar-portfolio
GITHUB_BRANCH=main
# Repo yapısına göre: htdocs alt klasör ise htdocs/data/
GITHUB_PATH_PREFIX=htdocs/data/
# Görseller (admin dosya yükleme): site kökü
GITHUB_SITE_PREFIX=htdocs/
# Admin kaydı sonrası Vercel deploy (Settings → Git → Deploy Hooks → main)
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/xxx

# --- Site asistanı (chatbot) — Google Gemini ---
# https://aistudio.google.com/apikey adresinden ücretsiz alınır
# Vercel → Project → Settings → Environment Variables'a ekle
GEMINI_API_KEY=AIzaSy_xxxxxxxx
# Opsiyonel: tek model zorlamak istersen (ör. hızlı lite modeller yeni hesaplarla daha uyumlu).
# Belirtilmezse kod sırayla dener: gemini-3.1-flash-lite → gemini-3.5-flash-lite → gemini-2.5-flash-lite → gemini-2.5-flash
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- fav.html galeri (Drive API) ---
GOOGLE_DRIVE_API_KEY=buraya_yeni_anahtar

# Google Cloud Console:
# 1. "Google Drive API" etkin olsun
# 2. API key → Application restrictions: None (sunucu tarafı)
# 3. API key → API restrictions: sadece Google Drive API
# 4. Drive klasörü: "Bağlantıya sahip olan herkes" görüntüleyebilir
